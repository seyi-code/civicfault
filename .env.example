# Database (PostGIS)
DATABASE_URL=postgresql+psycopg2://civic:civic@db:5432/civicfault

# App
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated) — include your Vercel domain in production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Clustering
CLUSTER_RADIUS_METERS=50

# Uploads
UPLOAD_DIR=static/uploads
MAX_UPLOAD_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Storage: local | s3
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# ML — path to fine-tuned weights (empty = mock)
YOLO_MODEL_PATH=

# Rate limits
RATE_LIMIT_REPORTS=10/minute
RATE_LIMIT_DEFAULT=60/minute

# Community moderation (0 = public immediately)
MIN_UPVOTES_FOR_PUBLIC=0

# Frontend (used by Next.js / Vercel)
NEXT_PUBLIC_API_URL=http://localhost:8000
